{
  "name": "bonj-cake-story",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--no-experimental-require-module\" next dev",
    "build": "NODE_OPTIONS=\"--no-experimental-require-module\" next build",
    "start": "NODE_OPTIONS=\"--no-experimental-require-module\" next start",
    "lint": "eslint .",
    "db:generate": "NODE_OPTIONS=\"--no-experimental-require-module\" node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "NODE_OPTIONS=\"--no-experimental-require-module\" node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.10.1",
    "drizzle-orm": "0.45.2",
    "gl-matrix": "^3.4.4",
    "next": "16.2.6",
    "postgres": "3.4.8",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
